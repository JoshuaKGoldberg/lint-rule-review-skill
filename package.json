{
	"name": "lint-rule-review",
	"version": "0.0.0",
	"description": "Claude Code skill that reviews custom lint rules by trying to break them.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/JoshuaKGoldberg/lint-rule-review.git"
	},
	"license": "MIT",
	"author": {
		"name": "Josh Goldberg",
		"email": "git@joshuakgoldberg.com"
	},
	"type": "module",
	"scripts": {
		"format": "prettier .",
		"lint": "eslint . --max-warnings 0",
		"lint:knip": "knip",
		"lint:spelling": "cspell \"**\" \".github/**/*\"",
		"prepare": "husky",
		"test": "vitest"
	},
	"lint-staged": {
		"*": "prettier --ignore-unknown --write"
	},
	"devDependencies": {
		"@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
		"@eslint/js": "10.0.1",
		"@eslint/markdown": "8.0.3",
		"@types/node": "26.6.2",
		"@vitest/coverage-v8": "5.0.1",
		"@vitest/eslint-plugin": "1.6.27",
		"console-fail-test": "0.10.0",
		"cspell": "10.4.0",
		"eslint": "10.14.0",
		"eslint-plugin-jsdoc": "65.4.0",
		"eslint-plugin-jsonc": "3.4.1",
		"eslint-plugin-markdown-links": "0.9.1",
		"eslint-plugin-n": "18.5.0",
		"eslint-plugin-package-json": "1.13.0",
		"eslint-plugin-perfectionist": "5.13.0",
		"eslint-plugin-regexp": "3.3.1",
		"eslint-plugin-yml": "3.9.0",
		"husky": "9.1.7",
		"knip": "6.44.0",
		"lint-staged": "17.6.0",
		"prettier": "^3.9.6",
		"prettier-plugin-curly": "0.4.1",
		"prettier-plugin-packagejson": "3.1.0",
		"prettier-plugin-padding-lines": "0.1.0",
		"prettier-plugin-sentences-per-line": "0.2.4",
		"prettier-plugin-sh": "0.20.0",
		"typescript": "5.9.3",
		"typescript-eslint": "8.71.0",
		"vitest": "5.0.1"
	},
	"packageManager": "pnpm@11.22.0",
	"engines": {
		"node": "^22.13.0 || ^24.11.0 || >=26.0.0"
	}
}
